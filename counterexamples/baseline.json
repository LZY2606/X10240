    {"op":"submit","stream":"M3","kind":"measurement","source":"实验室报告 LNK-2024-120","payload":{"labCode":"LNK-120","c14AgeBP":2850,"sigmaBP":40,"material":"海贝","unit":"14C yr BP","raw":"2850 ± 40 BP"}},
    {"op":"submit","stream":"M4","kind":"measurement","source":"实验室报告 LNK-2024-121","payload":{"labCode":"LNK-121","c14AgeBP":2905,"sigmaBP":30,"material":"炭化种子","unit":"14C yr BP","raw":"2905 ± 30 BP"}},
    {"op":"submit","stream":"M5","kind":"measurement","source":"实验室报告 LNK-2024-122","payload":{"labCode":"LNK-122","c14AgeBP":4440,"sigmaBP":25,"material":"泥炭","unit":"14C yr BP","raw":"4440 ± 25 BP"}},
    {"op":"submit","stream":"M9","kind":"measurement","source":"实验室报告 LNK-2024-123（数值缺失）","payload":{"labCode":"LNK-123","unit":"14C yr BP","raw":"not reported","diagnostic":"实验室未报告数值；保留原始表示"}},
